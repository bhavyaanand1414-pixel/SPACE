# ==============================================================================
# SIH1518: ISRO Satellite Change Intelligence Platform — Deployment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Deploy to Vercel)
# ------------------------------------------------------------------------------
# Set this in Vercel Dashboard > Project Settings > Environment Variables
VITE_API_BASE_URL=https://sih1518-backend.onrender.com/api/v1

# ------------------------------------------------------------------------------
# 2. BACKEND & ML CONFIGURATION (Deploy to Render Web Service)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
APP_NAME="ISRO SIH1518 Change Intelligence Platform"
APP_VERSION="1.0.0"
SECRET_KEY=replace_with_64_char_random_production_signing_key_here

# Service Ports (Local / Docker)
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL + PostGIS Database URL
# In Render: Automatically populated from Render Managed PostgreSQL
DATABASE_URL=postgresql://sih1518_admin:replace_password@sih1518-postgis-db:5432/sih1518_gis

# Redis URL (Render Managed Redis)
REDIS_URL=redis://red-xxxxxxxx:6379

# ML Execution Device (cpu / cuda / mps)
MODEL_DEVICE=cpu
MODEL_CHECKPOINT_DIR=./ml/checkpoints
BASELINE_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE: DATA & REPORTS (Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Set STORAGE_TYPE=s3 for Cloudflare R2 / AWS S3 in production, or local for dev
STORAGE_TYPE=local
LOCAL_STORAGE_PATH=./data/storage
REPORTS_STORAGE_PATH=./reports

# Cloudflare R2 S3-Compatible Credentials
# (Found in Cloudflare Dashboard > R2 > Manage R2 API Tokens)
S3_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=sih1518-storage
S3_REGION_NAME=auto
S3_CUSTOM_DOMAIN=storage.sih1518.org

# ------------------------------------------------------------------------------
# 4. SEMANTIC EMBEDDING ENGINE (PS 26227 — Fully Offline)
# ------------------------------------------------------------------------------
# No external API calls — all models run locally
EMBEDDING_MODEL_NAME=ViT-B-32
EMBEDDING_PRETRAINED=laion2b_s34b_b79k
EMBEDDING_WEIGHTS_PATH=./ml/checkpoints/clip
EMBEDDING_DIMENSION=512
FAISS_INDEX_PATH=./data/faiss_index
FAISS_INDEX_TYPE=Flat
TILE_SIZE=256
TILE_OVERLAP=32
SCENES_STORAGE_PATH=./data/scenes

# ------------------------------------------------------------------------------
# 5. CORS ORIGINS (Allowed Frontend Hosts)
# ------------------------------------------------------------------------------
CORS_ORIGINS=["https://*.vercel.app", "https://sih1518.vercel.app", "http://localhost:5173", "http://localhost:80", "http://localhost:3000"]
